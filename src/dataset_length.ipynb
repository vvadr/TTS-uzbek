    "from pathlib import Path\n",
    "import soundfile as sf\n",
    "\n",
    "files = sorted(Path(\"../data/raw_audios\").glob(\"*wav\"))\n",
    "\n",
    "total = sum(sf.info(p).duration for p in files)\n",
    "\n",
    "print(f\"{len(files)} files, {total / 3600:.2f} h ({total / 60:.1f} min)\")"
   ]
